{
  "name": "ryven",
  "version": "0.1.0",
  "private": true,
  "description": "RYVEN — The Development Engine",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "npm run build:main && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && npm run build:main && vite build",
    "test": "vitest run",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.ryven.ide",
    "productName": "RYVEN",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "assets/ryven.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/ryven.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RYVEN-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "RYVEN-${version}-${arch}-Portable.${ext}"
    }
  },
  "author": "RYVEN Project"
}
